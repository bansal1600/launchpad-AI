# Copy to .env.local and fill in. Restart `npm run dev` after editing.

# Chat model: set one of these. Without either, the chat uses a built-in keyword parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: force openai | anthropic | local when both keys are set
# CHAT_PROVIDER=openai
